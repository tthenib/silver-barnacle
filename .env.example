# Placeholder-only environment template. Never commit a populated .env file.
# All values are injected at runtime; the platform refuses to start live modes
# when required credentials are missing rather than falling back to defaults.

# Execution mode on startup. The platform always degrades to the safest mode on
# any doubt; see config/policies/execution.yaml. Valid: SIMULATION | EXECUTION_PAUSED
QP_STARTUP_MODE=SIMULATION

# Data providers (all optional; the synthetic provider needs no credentials).
QP_FRED_API_KEY=
QP_ALPHA_VANTAGE_API_KEY=
QP_FINNHUB_API_KEY=

# SEC EDGAR requires a descriptive User-Agent per SEC fair-access guidance.
QP_EDGAR_USER_AGENT=

# Broker (deferred; no live broker adapter is implemented yet).
QP_BROKER_ACCOUNT_ALIAS=
